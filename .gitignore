__pycache__/
*.py[cod]
*.egg-info/
.env
.venv/
venv/

# DVC-managed data directories — pipeline outputs, not tracked by Git
data/graphs/
data/netmob/processed/
data/cluster_first/

# MLflow
mlruns/

# Results (versioned by DVC): ignore the data, keep the .dvc pointer files
results/**
!results/**/
!results/**/*.dvc
!results/**/.gitignore

# Jupyter checkpoints
.ipynb_checkpoints/

# Models — trained checkpoints (DVC-tracked when they exist)
models/

# Training checkpoints (DVC-tracked)
checkpoints/

# Reports — track the thesis chapter source + figures + built PDF (deliverables);
# ignore only LaTeX build intermediates.
reports/*
!reports/chapter_forecaster.tex
!reports/chapter_forecaster.pdf
!reports/figures/
reports/*.aux
reports/*.log
reports/*.out
reports/*.toc
reports/*.fls
reports/*.fdb_latexmk
reports/*.synctex.gz

# Claude Code configuration
.claude/
mlflow.db

# Background-run logs, PIDs, and temp sweep configs (regenerable)
*.out
*.pid
.sweep_tmp/

# Downstream export bundle (DVC-tracked via the export_for_twin stage)
exports/
